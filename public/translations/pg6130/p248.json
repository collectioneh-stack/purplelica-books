["생각에 잠긴 채 그는 말했다. 그러고는 쓰러진 적의 숨 끊긴 가슴을 짓누르며 창을 뽑아내고, 시신을 위로 내던졌다. 김이 서리는 창을 휘두르며 그는 대담한 전차병을 향해 돌격했다. 그러나 날쌘 아우토메돈은 고삐를 늦추어 전차에 실린 채 아득한 들판 너머로 휩쓸려 갔으니, 그의 분노로부터 멀리, 불사의 준마들이 내달았다. 그 불사의 준마들은 제우스가 내린 선물이었다.", "[삽화: ] 아이스쿨라피우스\n165,183,193,203,213,223,233,243,253,263,273,283,293,303,313,323,333,343,353,363,373\n168,184,194,204,214,224,234,244,254,264,274,284,294,304,314,324,334,344,354,364,374\n169,185,195,205,215,225,235,245,255,265,275,285,295,305,315,325,335,345,355,365,375\n174,186,196,206,216,226,236,246,256,266,276,286,296,306,316,326,336,346,356,366\n175,187,197,207,217,227,237,247,257,267,277,287,297,307,317,327,337,347,357,367\n176,188,198,208,218,228,238,248,258,268,278,288,298,308,318,328,338,348,358,368\n178,189,199,209,219,229,239,249,259,269,279,289,299,309,319,329,339,349,359,369\n179,190,200,210,220,230,240,250,260,270,280,290,300,310,320,330,340,350,360,370\n181,191,201,211,221,231,241,251,261,271,281,291,301,311,321,331,341,351,361,371\n182,192,202,212,222,232,242,252,262,272,282,292,302,312,322,332,342,352,362,372"]